rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function staffExists() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    function staffRole() {
      return staffExists()
        ? firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role
        : '';
    }

    function normalizedRole(role) {
      return role == 'Admin' || role == 'admin' || role == 'Administrator'
        ? 'Admin'
        : role == 'Pastor' || role == 'pastor'
          ? 'Pastor'
          : role == 'Lead Pastor' || role == 'lead pastor'
            ? 'Lead Pastor'
            : role == 'Elder' || role == 'elder'
              ? 'Elder'
              : role == 'Leader' || role == 'leader'
                || role == 'Creative Arts Leader' || role == 'ca leader' || role == 'CA Leader'
                ? 'Leader'
                : role;
    }

    function userRole() {
      return normalizedRole(staffRole());
    }

    function canViewTravelling() {
      return userRole() in ['Admin', 'Pastor', 'Leader', 'Elder'];
    }

    function canManageTravelling() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin'];
    }

    function canViewMachanehMovies() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin', 'Leader', 'Elder'];
    }

    function canManageMachanehMovies() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin'];
    }

    function canViewMerchandise() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin', 'Leader', 'Elder'];
    }

    function canManageMerchandise() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin'];
    }

    function canViewShepherdingTools() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin', 'Leader', 'Elder'];
    }

    function canManageShepherdingTools() {
      return userRole() in ['Lead Pastor', 'Admin'];
    }

    function canViewAppFixes() {
      return userRole() in ['Lead Pastor', 'Pastor', 'Admin', 'Leader', 'Elder'];
    }

    function canManageAppFixes() {
      return userRole() in ['Lead Pastor', 'Admin'];
    }

    function isTravelDestinationPath(storagePath) {
      return storagePath.matches('travel-destinations/.*');
    }

    function isMachanehMoviePosterPath(storagePath) {
      return storagePath.matches('machaneh-movies/.*');
    }

    function isMerchandiseImagePath(storagePath) {
      return storagePath.matches('merchandise/.*');
    }

    function isShepherdingToolsCoverPath(storagePath) {
      return storagePath.matches('shepherding-tools/.*');
    }

    function isAppFixAttachmentPath(storagePath) {
      return storagePath.matches('app-fixes/.*');
    }

    function isAllowedTravelImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /travel-destinations/{destinationId}/{fileName} {
      allow read: if canViewTravelling();
      allow create, update: if canManageTravelling() && isAllowedTravelImage();
      allow delete: if canManageTravelling();
    }

    function isAllowedMoviePoster() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /machaneh-movies/{movieId}/{fileName} {
      allow read: if canViewMachanehMovies();
      allow create, update: if canManageMachanehMovies() && isAllowedMoviePoster();
      allow delete: if canManageMachanehMovies();
    }

    function isAllowedMerchandiseImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /merchandise/{itemId}/{fileName} {
      allow read: if canViewMerchandise();
      allow create, update: if canManageMerchandise() && isAllowedMerchandiseImage();
      allow delete: if canManageMerchandise();
    }

    function isAllowedShepherdingToolsCover() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /shepherding-tools/{resourceId}/{fileName} {
      allow read: if canViewShepherdingTools();
      allow create, update: if canManageShepherdingTools() && isAllowedShepherdingToolsCover();
      allow delete: if canManageShepherdingTools();
    }

    function isAllowedAppFixAttachment() {
      return request.resource != null
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        )
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /app-fixes/{requestId}/{fileName} {
      allow read: if canViewAppFixes();
      allow create, update: if canViewAppFixes() && isAllowedAppFixAttachment();
      allow delete: if canManageAppFixes();
    }

    // Development: allow authenticated access on other storage paths.
    match /{allPaths=**} {
      allow read, write: if isAuthenticated()
        && !isTravelDestinationPath(allPaths)
        && !isMachanehMoviePosterPath(allPaths)
        && !isMerchandiseImagePath(allPaths)
        && !isShepherdingToolsCoverPath(allPaths)
        && !isAppFixAttachmentPath(allPaths);
    }
  }
}
